# Mail Configuration - SendGrid (Bot Email gratuit - 100 emails/jour)
# 1. Créer un compte sur https://sendgrid.com (gratuit)
# 2. Créer une API Key dans Settings > API Keys
# 3. Remplacer YOUR_SENDGRID_API_KEY ci-dessous
MAIL_SERVER=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=apikey
MAIL_PASSWORD=YOUR_SENDGRID_API_KEY
MAIL_DEFAULT_SENDER_NAME=Escrime Blois
MAIL_DEFAULT_SENDER_EMAIL=noreply@escrimeblois.com
