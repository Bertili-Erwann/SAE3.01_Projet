}

#foot_section_2_bis {
  display: flex;
  flex-wrap: wrap;
  flex-basis: 40%;
  margin-bottom: 5%;
}

#foot_div_1,
#foot_div_2,
#foot_div_3 {
  display: flex;
  flex-wrap: nowrap;
  flex-basis: 60%;
  margin-right: 38%;
  margin-left: 2%;
  margin-top: 2%;
}

#foot_image_email,
#foot_image_tel,
#foot_image_geo {
  margin-right: 2%;
