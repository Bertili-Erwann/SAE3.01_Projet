/* -------------------- nav_responsable.html --------------------*/

#resp_navbar{
  background-color: #cacaca;
  padding: 10px 0;
  box-shadow: 0 0px 40px 0px rgba(0, 0, 0, 0.15);
}

#nav_responsable{
  display: flex;
  flex-wrap: nowrap;
  justify-content: center;
  list-style: none;
  margin: 0;
  padding: 0;
}

#nav_admin > li,
#nav_inscr > li
#nav_responsable > li{
  flex-basis: 20%;
  margin: 0 10px;
}

#nav_admin > li a,
#nav_inscr > li a {
  text-decoration: none;
  color: #333;
  padding: 12px 20px;
  display: block;
  border-radius: 8px;
  transition: all 0.3s ease;
  text-align: center;
}

#nav_admin > li:hover a,
#nav_inscr > li:hover a {
  font-weight: bold;
  color: #357abd;
  background-color: rgba(74, 144, 226, 0.1);
}

#blank_space {
  padding-top: 60px;
}

.demande_inscription_item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20px;
  margin: 10px auto;
  max-width: 600px;
  background-color: #f0f0f0;
  border-radius: 10px;
  transition: all 0.3s ease;
  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
}

.demande_inscription_item:hover {
  background-color: #e8e8e8;
  box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
}

.inscription_liste h1 {
  text-align: center;
  color: #333;
  font-size: 32px;
  margin: 30px 0;
  font-weight: 600;
  letter-spacing: 1px;
}

.demande_inscription_item button {
  background-color: #949494;
  color: white;
  padding: 8px 20px;
  border: none;
  border-radius: 20px;
  cursor: pointer;
  font-size: 14px;
  transition: all 0.3s;
}

.demande_inscription_item button:hover {
  background-color: #d3d3d3;
  transform: scale(1.05);
}

.inscription_view {
  max-width: 600px;
  margin: 40px auto;
  text-align: center;
}

.inscription_view h2 {
  color: #333;
  font-size: 28px;
  margin-bottom: 20px;
  font-weight: 600;
  letter-spacing: 1px;
}

.inscription_view > a button {
  background-color: #d90000;
  color: white;
  padding: 10px 25px;
  border: none;
  border-radius: 20px;
  cursor: pointer;
  font-size: 14px;
  transition: all 0.3s;
}

.inscription_view > a button:hover {
  background-color: #ff5d5d;
  transform: scale(1.05);
}

.inscription_details {
  background-color: #f0f0f0;
  padding: 30px;
  border-radius: 10px;
  margin-top: 20px;
  text-align: left;
  transition: all 0.3s ease;
  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
}

.inscription_details:hover {
  box-shadow: 0 5px 15px rgba(0, 0, 0, 0.15);
}

.inscription_details p {
  margin: 15px 0;
  padding: 8px;
  border-radius: 5px;
  transition: all 0.2s ease;
}

.inscription_details p:hover {
  background-color: rgba(255, 255, 255, 0.6);
  transform: translateX(5px);
}

.inscription_buttons {
  margin-top: 30px;
  text-align: center;
}

.inscription_buttons button {
  padding: 10px 30px;
  margin: 0 10px;
  border: none;
  border-radius: 5px;
  cursor: pointer;
  font-size: 16px;
  transition: all 0.3s ease;
  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.2);
}


.inscription_buttons button[value="accepter"] {
  background-color: #4CAF50;
  color: white;
}

.inscription_buttons button[value="accepter"]:hover {
  background-color: #45a049;
  transform: scale(1.05);
}

.inscription_buttons button[value="refuser"] {
  background-color: #d90000;
  color: white;
}

.inscription_buttons button[value="refuser"]:hover {
  background-color: #ff1a1a;
  transform: scale(1.05);
}

.inscription_details a {
  color: #0066cc;
  text-decoration: none;
  transition: all 0.3s ease;
  padding: 2px 5px;
  border-radius: 3px;
}

.inscription_details a:hover {
  color: #0052a3;
  background-color: rgba(0, 102, 204, 0.1);
  text-decoration: underline;
  transform: scale(1.05);
}

.inscription_view h2 {
  transition: all 0.3s ease;
}

.inscription_view h2:hover {
  color: #555;
  transform: scale(1.02);
#nav_responsable > li:hover{
  font-weight: bold;
}

#blank_space{
  padding:25px;
}

#nav_responsable .nav-link {
  text-decoration: none;
  color: #333;
  text-align: center;
  margin-right: 20px;
}

#nav_responsable .nav-link:hover {
  color: #000;
}

/* -------------------- gestion_formulaire.html --------------------*/

#gest_form {
  margin: 1%;
  align-content: center;

}

.text_form {
  text-align: center;
  margin-bottom: 20px;
}

#table_form {
  position: relative;
  padding-top: 60px;
  border-radius: 10px;
  overflow: scroll;
}

#container_table_form {
  margin-left: 10%;
  width: 80%;
  min-height: 100vh;
  display: flex;
  flex-wrap: wrap;
  padding-top: 20px;
  background-color: #ffffff;
}

#formulaire {
  display: flex;
  flex-wrap: nowrap;
  background-color: #ffffff;
  border-radius: 20px;
  width: 90%;
  margin-top: -40px;
  margin-bottom: 60px;
  margin-left: 5%;
  margin-right: 5%;
  border-style: solid;
  border-width: 2px;
  align-items: center;
}

#formulaire_infos,
#formulaire_options {
  flex-basis: 44%;
  margin-bottom: 10px;
  margin-top: 10px;
  margin-left: 3%;
  margin-right: 3%;
}

#formulaire_options {
  display: flex;
  flex-wrap: nowrap;
}

.gest_form_button_container {
  margin-right: 5px;
  margin-left: 5px;
}

#form_consulter,
#form_supprimer {
  border-radius: 20px;
  margin-right: 20px;
  margin-left: 20px;
  padding-left: 30px;
  padding-right: 30px;
  width: 100%;
  border-style: solid;
  border-color: #000;
}

#form_consulter {
  background-color: #949494;
}

#form_consulter:hover {
  background-color: #d3d3d3;
}

#form_supprimer {
  background-color: #D90000;
}

#form_supprimer:hover {
  background-color: #ff5d5d;
}

/* -------------------- nav_creation_event.html --------------------*/

#blank_space_2 {
  padding:2px;
}

/* -------------------- creation_entrainement.html --------------------*/


.event_creation_area {
  display: flex;
  flex-wrap: nowrap;
  margin-bottom: 5px;
}

#event_creation__bottom_area {
  margin-bottom: 10px;
}

.event_container {
  display: flex;
  flex-wrap: nowrap;
  align-items: baseline;
  flex-grow: 1;
}

#event_creation_global_container {
  width: 50%;
  padding: 10px;
  margin-left: 25%;
  margin-top: 30px;
  border-radius: 15px;
  background-color: #d3d3d3;
  margin-bottom: 20px;
  box-shadow: 0 0px 40px 0px rgba(0, 0, 0, 0.15);
}

#event_creation_title {
  text-align: center;
  margin: 20px;
}

.creation_event_info_required_area {
  margin-left: 5%;
  margin-right: 3%;
  flex-basis: 80%;
}

.creation_event_text {
  margin-left: 2%;
  flex-basis: 10%;
}

#type_create_event_div {
  display: flex;
  flex-wrap: nowrap;
  align-items: baseline;
}

#create_event_save {
  border-radius: 5px;
  margin-left: 40%;
  margin-top: 20px;
  width: 20%;
  background-color: #1ECC2A;
}
/* -------------------- consultation_form.html --------------------*/

#consult_form {
  margin: 20px;
}

#info_form_area {
  text-align: center;
}

.data_form {
  margin-left: 5px;
}

.form_area {
  display: flex;
  flex-wrap: nowrap;
}

#reponse_form_area {
  margin-bottom: 20px;
}

#form_button_area {
  display: flex;
  flex-wrap: wrap;
  flex-basis: 50%;
  margin-left: 25%;
}

.form_button_container {
  width: 30%;

}

#form_bouton_back,
#form_bouton_rep {
  border-radius: 5px;
  margin-left: 25%;
  width: 50%;
}

#form_bouton_back {
