/* ==================== Membre - Informations ==================== */

.infos-container-v2 {
    background-color: var(--bg-body);
    border-radius: 10px;
    padding: 20px;
    box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
    max-width: 1200px;
    margin: 2rem auto;
}

.section-v2 {
    background-color: var(--text-white);
    padding: 1.5rem;
    margin-bottom: 2rem;
    border-radius: 8px;
}

.section-v2 h2 {
    color: var(--text-main);
    font-size: 1.2rem;
    margin-bottom: 1.5rem;
}

.form-columns-v2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
}

.form-col-v2 {
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

.form-field-v2 {
    margin-bottom: 1rem;
}

.form-field-v2 label {
    display: block;
    margin-bottom: 0.5rem;
    color: var(--text-main);
    font-weight: 500;
}

.form-field-v2 input,
.form-field-v2 select {
    width: 100%;
    padding: 0.5rem;
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-sm);
    font-size: 14px;
}

.form-field-v2 input:disabled {
    background-color: var(--gray-200);
    color: var(--gray-600);
    cursor: not-allowed;
}

.submit-btn-v2 {
    padding: 0.5rem 2rem;
    border: none;
    border-radius: 4px;
    color: var(--text-white);
    cursor: pointer;
    font-weight: bold;
    font-size: 14px;
    margin-left: auto;
    margin-right: auto;
}

.green-btn-v2 {
    background-color: var(--success);
}

.green-btn-v2:hover {
    background-color: var(--success-hover);
}

.non-modifiable-v2 {
    color: var(--gray-600);
}

.modifiable-v2 {
    color: var(--success);
}

span.non-modifiable-v2,
span.modifiable-v2 {
    margin-left: 0.25rem;
}

/* ==================== Détails/Sommaire ==================== */
summary {
    cursor: pointer;
    outline: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    list-style: none;
}

summary::-webkit-details-marker {
    display: none;
}

summary::after,
.ic::after {
    content: '▶';
    font-size: 1em;
    transition: transform 0.3s ease;
    margin-left: 10px;
    display: inline-block;
}

details[open] summary::after {
    transform: rotate(90deg);
}

summary h2 {
    display: inline-block;
    margin-bottom: 0;
    vertical-align: middle;
}

.section-v2 summary h2 {
    margin-bottom: 0;
}

details[open] summary {
    margin-bottom: 1.5rem;
}

/* ==================== Voir MDP ==================== */
.password-wrapper {
    position: relative;
    display: flex;
    align-items: center;
}

.password-wrapper input {
    padding-right: 40px;
}

.toggle-password {
    position: absolute;
    right: 10px;
    cursor: pointer;
    user-select: none;
    font-size: 1.2em;
    padding: 5px;
}